# ====================================================================
# FinNice Capstone Project - Root .gitignore
# ====================================================================

# 1. FILE SENSITIF & KRITIKAL (WAJIB DIABAIKAN)
# --------------------------------------------------------------------
# Mengandung API Key (seperti GEMINI_API_KEY), password database, dll.
.env
.env.local
.env.*.local
*.env
ai-service/.env
backend/src/.env

# 2. PYTHON (AI-SERVICE) CACHE & COMPILED FILES
# --------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/
ai-service/__pycache__/
ai-service/logs/
ai-service/fit/
logs/

# 3. PYTHON VIRTUAL ENVIRONMENTS
# --------------------------------------------------------------------
.venv/
venv/
env/
ENV/
ai-service/.venv/
ai-service/venv/
ai-service/env/

# 4. NODE.JS DEPENDENCIES & LOGS (BACKEND & FRONTEND)
# --------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# 5. PRODUCTION BUILDS (FRONTEND)
# --------------------------------------------------------------------
frontend/dist/
frontend/build/
dist/
build/
out/
.next/

# 6. IDE & SYSTEM FILES (SAMPAH SISTEM OPERASI & EDITOR)
# --------------------------------------------------------------------
.vscode/
.idea/
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
